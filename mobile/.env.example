# Copy to .env and adjust for your setup. See src/shared/env.ts for details.
# Web preview / iOS simulator:
EXPO_PUBLIC_API_URL=http://localhost/api
# Android emulator: EXPO_PUBLIC_API_URL=http://10.0.2.2/api
# Physical device (Expo Go, same Wi-Fi as your dev machine): EXPO_PUBLIC_API_URL=http://<your-lan-ip>/api
